# =============================================================================
# JOL Tenant Website — Parameterized Dockerfile
# =============================================================================
# Template variables: {{APP_NAME}}, {{NODE_VERSION}}, {{APP_PORT}}
# Generated by jol-deploy. Do not edit tenant copies directly.
# =============================================================================

FROM node:{{NODE_VERSION:-20}}-alpine AS builder

WORKDIR /app

# Install dependencies (cached layer)
COPY package.json package-lock.json* ./
RUN npm ci --production=false

# Copy application source
COPY . .

# Build
RUN npm run build

# --- Production stage ---
FROM node:{{NODE_VERSION:-20}}-alpine AS production

LABEL org.opencontainers.image.title="{{APP_NAME}}"
LABEL org.opencontainers.image.vendor="Journey Of Life"
LABEL org.opencontainers.image.source="https://github.com/journeyoflife-org/{{APP_NAME}}"

# Security: run as non-root
RUN addgroup -g 1001 -S jol && adduser -S jol -u 1001 -G jol

WORKDIR /app

COPY --from=builder --chown=jol:jol /app/dist ./dist
COPY --from=builder --chown=jol:jol /app/node_modules ./node_modules
COPY --from=builder --chown=jol:jol /app/package.json ./

USER jol

ENV NODE_ENV=production
ENV PORT={{APP_PORT:-3000}}
ENV TENANT={{APP_NAME}}

EXPOSE {{APP_PORT:-3000}}

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:{{APP_PORT:-3000}}/health || exit 1

CMD ["node", "dist/server.js"]
