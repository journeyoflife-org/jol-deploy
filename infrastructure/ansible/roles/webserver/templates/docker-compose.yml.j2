---
# Docker Compose for tenant: {{ tenant }}
# Environment: {{ jol_environment }}
# Generated by jol-deploy — DO NOT EDIT MANUALLY

services:
  app:
    image: "{{ tenant }}:{{ app_version | default('latest') }}"
    container_name: "{{ tenant }}-app"
    restart: unless-stopped
    ports:
      - "{{ app_port | default(3000) }}:3000"
    environment:
      - NODE_ENV={{ jol_environment }}
      - TENANT={{ tenant }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - tenant-net
    deploy:
      resources:
        limits:
          memory: {{ app_memory_limit | default('512M') }}
          cpus: '{{ app_cpu_limit | default("1.0") }}'

  nginx:
    image: nginx:1.27-alpine
    container_name: "{{ tenant }}-nginx"
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app
    networks:
      - tenant-net

networks:
  tenant-net:
    driver: bridge
