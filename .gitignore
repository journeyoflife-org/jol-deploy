*.py[cod]
*$py.class
.venv/
*.egg-info/
dist/
build/
.eggs/

# --- Secrets & Credentials ---
*.secret
*.credentials
.env
.env.*
*.pem
*.key
*.crt

# --- OS ---
.DS_Store
Thumbs.db
*.bak
*.tmp
